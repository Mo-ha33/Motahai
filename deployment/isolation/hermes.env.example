# Hermes side ONLY. Copy to hermes.env (chmod 0600). Contains NO Core secret: no database URL, no Fernet key,
# no operator key, and NEVER the HITL private key. All values below are placeholders.

# --- Where Core's internal API lives (core_internal network / private address) ---
CORE_API_BASE_URL=https://core-api.internal.example.invalid:8000
CORE_SERVICE_TOKEN=REPLACE_WITH_THE_SAME_SCOPED_TOKEN_CORE_ISSUED

# --- Rule D-003: PUBLIC key only (base64url raw 32 bytes, printed by `generate-keypair`) ---
HITL_VERIFY_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY_BASE64URL
# Alternative: HITL_VERIFY_PUBLIC_KEY_PATH=/etc/hermes/hitl_public.pem
HITL_USED_NONCES_PATH=/home/hermes/.hermes/hitl_used_nonces.json

# --- Per-tenant MCP capability tokens (one per client; scope = that tenant's tools/data only) ---
MCP_TENANT_TOKENS_FILE=/etc/hermes/mcp_tenant_tokens.json

# --- LLM provider key for the agent itself (not a Core secret) ---
LLM_PROVIDER_API_KEY=REPLACE_WITH_PROVIDER_KEY
