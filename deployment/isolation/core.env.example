# Core side ONLY. Copy to core.env (chmod 0600). Never copy these values to the Hermes host.
# All values below are placeholders.

# --- Database (the password must match postgres.env) ---
DATABASE_URL=postgresql+psycopg://motahai:REPLACE_WITH_LONG_RANDOM@postgres:5432/motahai

# --- Encryption of stored platform credentials (Fernet). Generate with credentials.generate_key() ---
MOTAHAI_FERNET_KEY=REPLACE_WITH_FERNET_KEY

# --- Rule D-003 approvals: Ed25519 PRIVATE key file (path inside the container). Public key goes to Hermes. ---
HITL_SIGNING_PRIVATE_KEY_PATH=/run/secrets/hitl_private.pem
OPERATOR_API_KEY=REPLACE_WITH_LONG_RANDOM_DIFFERENT_FROM_EVERY_OTHER_KEY

# --- Service token Hermes presents to Core (Core stores only what it needs to validate it) ---
# Scoped: lets Hermes call the agent-facing Core API; cannot reach /approvals/*.
CORE_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM
HERMES_API_KEY=REPLACE_WITH_LONG_RANDOM_FOR_CORE_TO_HERMES_NOTIFICATIONS_ONLY

# --- Scheduler ---
MOTAHAI_RUN_SCHEDULER_IN_APP=0

# --- Courier webhooks (optional; defaults shown) ---
# OTO replay window: the signed timestamp must be at most this old, and at most the skew in the future.
# OTO_WEBHOOK_MAX_AGE_SECONDS=3600
# OTO_MAX_FUTURE_SKEW_SECONDS=300
